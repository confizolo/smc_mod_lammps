####################################
####	GROUPS	             #######
####################################

group all type 1 2 3

#1 = dna
#2 = condensins ends
#3 = beads next to condensin ends <= used to prevent entanglement and breaking

####################################
####    VARIABLES	     #######
####################################

variable lp equal 5
variable seed2 equal 1

####################################
####	RADII	             #######
####################################
variable rpo equal 1.0 #diameter polymer
variable rsl equal 1.0 #diameter condensin atom
variable rps equal 1.6 #type 1 sees type 2 as a bead of size 2.6 sigma, type 3 sees type 2 as a bead of size rsl!!

####################################
####	SIZES                #######
####################################
variable rpopo equal (${rpo}+${rpo})/2. 
variable rslsl equal (${rsl}+${rsl})/2. 
variable rslpo equal (${rsl}+${rpo})/2. 
variable rpsps equal (${rps}+${rps})/2. 

####################################
####	CUTOFFs	             #######
####################################
variable rpopocoff equal ${rpopo}*2^(1/6.) 
variable rslslcoff equal ${rslsl}*2^(1/6.) 
variable rslpocoff equal ${rslpo}*2^(1/6.)
variable rpspscoff equal ${rpsps}*2^(1/6.)

variable ssbdist equal 1.6*${rpopocoff}

####################################
####    PAIR INTERACTIONS    #######
####################################
pair_style  lj/cut 2.5
pair_modify     shift yes	###shift lj potential to 0.0 at cutoff
pair_coeff      1 1 1.0 ${rpopo} ${rpopocoff}
pair_coeff      1 2 1.0 ${rpsps} ${rpspscoff}
pair_coeff      1 3 1.0 ${rpopo} ${rpopocoff}
pair_coeff      2 2 1.0 ${rslsl} ${rslpocoff}
pair_coeff      2 3 1.0 ${rslpo} ${rslpocoff}
pair_coeff      3 3 1.0 ${rpopo} ${rpopocoff}

####################################
####    FENE BONDS           #######
####################################
bond_style hybrid fene harmonic
special_bonds fene#<=== I M P O R T A N T (new command)
#bond_coeff   * harmonic 10 1.5
bond_coeff   1 fene  30.0   1.5  1.0  1.0
bond_coeff   2 harmonic 4 ${ssbdist}
bond_coeff   3 harmonic 4 ${ssbdist}

####################################
####    ANGLES                #######
####################################
angle_style cosine
angle_coeff 1 ${lp}

######################################
# INTEGRATION OF Equations of motion #
######################################
fix 1 dna   nve
fix 2 all  langevin   1.0 1.0   1.0  ${seed2}
fix 3 all smc 1000 234224 2 2

######################
#### CUSTOM INFO #####
######################
thermo 10000
thermo_style   custom   step  temp  epair vol cpu
timestep 0.01
reset_timestep 0
